{
    "compilerOptions": {
        "strict": true,
        "esModuleInterop": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["node"],
        "declaration": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true,
        "outDir": "dist"
    },
    "include": ["src", "bin"],
    "exclude": ["node_modules", "dist"]
}
